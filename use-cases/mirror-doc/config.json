{
    "base_url": "https://mirror-networking.gitbook.io/docs",
    "url_list_file": null,
    "start_urls": [
        "https://mirror-networking.gitbook.io/docs"
    ],
    "max_workers": 6,
    "max_retries": 3,
    "timeout": 20,
    "delay_between_requests": 1.0,
    "server_intensity": 0.5,
    "output_dir": "output/mirror-doc",
    "merge_output": "output/mirror-doc/merged_documentation.md",
    "categories": [
        "Documentation",
        "API",
        "Guides",
        "Other"
    ],
    "category_order": [
        "Documentation",
        "API",
        "Guides",
        "Other"
    ],
    "clean_content": true,
    "add_metadata": true,
    "use_readability": true,
    "convert_to_markdown": true,
    "include_toc": true
}